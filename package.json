{
  "name": "www.eltink.net",
  "version": "1.0.24",
  "description": "Site is created with eleventy.",
  "main": "index.js",
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@11ty/eleventy-img": "^5.0.0",
    "@11ty/eleventy-plugin-rss": "^2.0.2",
    "autoprefixer": "^10.4.20",
    "cssnano": "^7.0.6",
    "fast-glob": "^3.3.2",
    "html-minifier-terser": "^7.2.0",
    "markdownlint": "^0.37.2",
    "markdownlint-cli": "^0.43.0",
    "md5": "^2.3.0",
    "postcss-cli": "^11.0.0",
    "postcss-import": "^16.1.0",
    "prettier": "^3.4.2",
    "striptags": "^3.2.0",
    "stylelint": "^16.12.0",
    "stylelint-config-recess-order": "^5.1.1",
    "stylelint-config-recommended": "^14.0.1"
  },
  "scripts": {
    "build": "npx @11ty/eleventy",
    "build-production": "NODE_ENV=production npx @11ty/eleventy",
    "serve": "npx @11ty/eleventy --serve --port=8091",
    "serve-production": "NODE_ENV=production npx @11ty/eleventy --serve --port=8091",
    "lint": "npm run lint:md && npm run lint:css",
    "lint:md": "markdownlint src/**/*.md",
    "lint:css": "stylelint src/assets/**/*.css",
    "format": "prettier --write '**/*.{js,css,html,md}'",
    "test": "npm run build && npm run lint && npm run check-links"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geerteltink/www.eltink.net.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/geerteltink/www.eltink.net/issues"
  },
  "homepage": "https://github.com/geerteltink/www.eltink.net#readme",
  "dependencies": {
    "lodash": "^4.17.21"
  }
}
